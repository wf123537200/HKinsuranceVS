# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.env*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# database
*.db
*.db-journal

# archived / local-only PDFs (NOT deployed, NOT vector source)
# Used for: keeping old / unused PDFs locally without committing them.
# Active product PDFs live in /public/pdfs/ and /public/pdf-by-company/ (which ARE committed).
/public/other-pdf/

# PDF text extracts (.txt) — generated by scripts/extract-*.mjs as intermediate
# products for one-shot data extraction. Not used by the app, regenerated on demand.
# Pattern is broad on purpose — also catches any future /public/**/\.txt scratch files.
/public/**/*.txt

# --- pre-deploy cleanup (Policy Vector deployment) ---
# v1 deployment: PDFs moved to Cloudflare R2. public/pdfs/ is
# kept locally for backup but is not part of the deployable bundle.
public/pdfs/

# Internal scratch / debug reports. Single-use artifacts that should
# never be committed. Keep them on disk in case you need them; just
# don't push.
audit.txt
final-coverage*.txt
db-vs-selected*.txt
list-missing.txt
match-pdfs-report.txt
off-list-report.txt
plan-changes.txt
seed-displaynames.txt
selected-with-pdf-report.txt
dev.log
*.log
# .ts/.cjs/.mjs variants of the same one-shot debug scripts (above
# patterns only match the .txt/.log names; the actual scripts live
# in scripts/ as different extensions).
scripts/db-vs-selected.*
scripts/final-coverage-check.*
scripts/list-missing.*
scripts/match-pdfs-to-selected.*
scripts/plan-changes.*

# One-shot pre-deploy / pre-refactor backups. These are local-only.
.tmp-*/
.tmp-*
docs/
backup-before-*/
data.backup-*/
*.zip

# Editor / IDE state (per-user, not project)
.vscode/

# Backup / one-off edits that should never be committed
*.bak
*.bak-*

# Build / lint / dev-server runtime state files
scripts/.pdf-server-port
scripts/build-output.txt
scripts/lint-output.txt
